# Nonsecret defaults for the single production checkout.
# settings.env supplies production paths and endpoints.
# DOMAIN and secret inputs come from Doppler rajohan/prd.
TZ='Europe/Oslo'
PUID='1001'
PGID='1001'
GOST_LOCAL_HOSTNAME='gluetun:8888'
BITMAGNET_LOCAL_HOSTNAME='gluetun:3333'
JACKETT_LOCAL_HOSTNAME='gluetun:9117'
MEDIAFLOW_LOCAL_HOSTNAME='mediaflow:8888'
AIOMETADATA_HOSTNAME=aiometadata.${HOMELAB_SERVICES_DOMAIN?Missing DOMAIN}
AIOSTREAMS_HOSTNAME=aiostreams.${HOMELAB_SERVICES_DOMAIN?Missing DOMAIN}
COMET_HOSTNAME=comet.${HOMELAB_SERVICES_DOMAIN?Missing DOMAIN}
MEDIAFLOW_HOSTNAME=proxy.${HOMELAB_SERVICES_DOMAIN?Missing DOMAIN}
