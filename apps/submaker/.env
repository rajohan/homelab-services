# Nonsecret settings and references; Doppler is loaded fresh by bin/compose.
ENCRYPTION_KEY=${HOMELAB_SERVICES_SUBMAKER_ENCRYPTION_KEY?Missing SUBMAKER_ENCRYPTION_KEY}
OPENSUBTITLES_API_KEY=${HOMELAB_SERVICES_OPENSUBTITLES_API_KEY?Missing OPENSUBTITLES_API_KEY}
REDIS_DB='2'
REDIS_HOST='valkey-submaker'
REDIS_PASSWORD=${HOMELAB_SERVICES_VALKEY_SUBMAKER_PASSWORD?Missing Redis password}
REDIS_PORT='6379'
SCS_MANIFEST_TOKEN=${HOMELAB_SERVICES_SCS_MANIFEST_TOKEN?Missing SCS_MANIFEST_TOKEN}
STORAGE_TYPE='redis'

# Native payload quotas; 96 MiB Redis overhead headroom.
CACHE_LIMIT_AUTOSUB=16777216
CACHE_LIMIT_BYPASS=8388608
CACHE_LIMIT_EMBEDDED=16777216
CACHE_LIMIT_HISTORY=16777216
CACHE_LIMIT_PARTIAL=8388608
CACHE_LIMIT_PROVIDER_META=8388608
CACHE_LIMIT_SMDB=41943040
CACHE_LIMIT_SYNC=16777216
CACHE_LIMIT_TRANSLATION=67108864
SESSION_STORAGE_MAX_BYTES=33554432
