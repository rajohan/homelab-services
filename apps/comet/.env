# Nonsecret settings and references; Doppler is loaded fresh by bin/compose.
ADMIN_DASHBOARD_PASSWORD=${HOMELAB_WEB_PASSWORD?Missing HOMELAB_WEB_PASSWORD}
ANIME_MAPPING_ENABLED='False'
BACKGROUND_SCRAPER_CONCURRENT_WORKERS='2'
BACKGROUND_SCRAPER_ENABLED=${HOMELAB_SERVICES_COMET_BACKGROUND_SCRAPER?Select environment}
BACKGROUND_SCRAPER_RUN_TIME_BUDGET='2400'
BITMAGNET_URL=http://${BITMAGNET_LOCAL_HOSTNAME?Missing BITMAGNET_LOCAL_HOSTNAME}
COMETNET_ADVERTISE_URL=${HOMELAB_SERVICES_COMETNET_ADVERTISE_URL?Select environment}
COMETNET_BOOTSTRAP_NODES=${HOMELAB_SERVICES_COMETNET_BOOTSTRAP_NODES?Select environment}
COMETNET_ENABLED=${HOMELAB_SERVICES_COMETNET_ENABLED?Select environment}
COMETNET_KEYS_DIR=${HOMELAB_SERVICES_COMETNET_KEYS_DIR?Select environment}
COMETNET_POOLS_DIR=${HOMELAB_SERVICES_COMETNET_POOLS_DIR?Select environment}
COMETNET_KEY_PASSWORD=${HOMELAB_SERVICES_SERVICE_PASSWORD?Missing PASSWORD}
COMETNET_MIN_PEERS='15'
COMETNET_STATE_SAVE_INTERVAL='60'
COMETNET_NODE_ALIAS=${HOMELAB_SERVICES_COMETNET_NODE_ALIAS?Select environment}
COMETNET_SKIP_REACHABILITY_CHECK='False'
COMETNET_SKIP_TIME_CHECK='False'
COMETNET_ALLOW_PRIVATE_PEX='False'
COMETNET_UPNP_ENABLED='False'
FASTAPI_WORKERS='1'
DATABASE_TYPE='postgresql'
DATABASE_URL=postgresql://comet_app:${HOMELAB_SERVICES_DB_COMET_PASSWORD_URIENCODED?Missing database password}@${HOMELAB_SERVICES_DB_HOST?Select environment}:${HOMELAB_SERVICES_DB_PORT?Select environment}/comet?ssl=${HOMELAB_SERVICES_DB_COMET_TLS?Select environment}&min_size=1&max_size=6
DMM_INGEST_CONCURRENT_WORKERS='2'
DMM_INGEST_ENABLED=${HOMELAB_SERVICES_COMET_DMM_INGEST?Select environment}
EXECUTOR_MAX_WORKERS='4'
GLOBAL_PROXY_URL=http://${GOST_LOCAL_HOSTNAME?Missing GOST_LOCAL_HOSTNAME}
JACKETT_API_KEY=${HOMELAB_SERVICES_JACKETT_API_KEY?Missing JACKETT_API_KEY}
JACKETT_URL=http://${JACKETT_LOCAL_HOSTNAME?Missing JACKETT_LOCAL_HOSTNAME}
PGSSLROOTCERT='/run/homelab-ca.pem'
PUBLIC_BASE_URL=${HOMELAB_SERVICES_COMET_BASE_URL?Select environment}
SCRAPE_BITMAGNET='live'
SCRAPE_DMM='live'
SCRAPE_JACKETT='both'
TMDB_READ_ACCESS_TOKEN=${HOMELAB_SERVICES_TMDB_ACCESS_TOKEN?Missing TMDB_ACCESS_TOKEN}
TZ=${TZ?Missing TZ}
