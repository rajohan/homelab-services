# Nonsecret settings and references; Doppler is loaded fresh by bin/compose.
ALL_PROXY='true'
API_PASSWORD=${HOMELAB_WEB_USERNAME?Missing USERNAME}:${HOMELAB_SERVICES_SERVICE_PASSWORD?Missing PASSWORD}
PROXY_URL=http://${GOST_LOCAL_HOSTNAME?Missing GOST_LOCAL_HOSTNAME}
REDIS_URL=redis://:${HOMELAB_SERVICES_VALKEY_CACHE_PASSWORD_URIENCODED?Missing Redis password}@valkey-cache:6379/1
TZ=${TZ?Missing TZ}
