# Nonsecret settings and references; Doppler is loaded fresh by bin/compose.
DNS_ADDRESS='127.0.0.11'
FIREWALL_INPUT_PORTS='3333,9117,8888,8191'
FIREWALL_OUTBOUND_SUBNETS=${HOMELAB_SERVICES_GLUETUN_OUTBOUND_SUBNETS?Select environment}
OPENVPN_PASSWORD=${HOMELAB_SERVICES_NORDVPN_PASSWORD?Missing NORDVPN_PASSWORD}
OPENVPN_USER=${HOMELAB_SERVICES_NORDVPN_USERNAME?Missing NORDVPN_USERNAME}
SERVER_CATEGORIES='P2P'
SERVER_COUNTRIES='Netherlands'
TZ=${TZ?Missing TZ}
UPDATER_PERIOD='480h'
VPN_SERVICE_PROVIDER='nordvpn'
VPN_TYPE='openvpn'
