# Nonsecret settings and references; Doppler is loaded fresh by bin/compose.
POSTGRES_DSN=postgresql://bitmagnet_app:${HOMELAB_SERVICES_DB_BITMAGNET_PASSWORD_URIENCODED?Missing database password}@${HOMELAB_SERVICES_DB_HOST?Select environment}:${HOMELAB_SERVICES_DB_PORT?Select environment}/bitmagnet?${HOMELAB_SERVICES_DB_TLS_QUERY?Select environment}&pool_max_conns=6&pool_min_conns=1
TMDB_API_KEY=${HOMELAB_SERVICES_TMDB_API_KEY?Missing TMDB_API_KEY}
TZ=${TZ?Missing TZ}
