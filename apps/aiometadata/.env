# Nonsecret settings and references; Doppler is loaded fresh by bin/compose.
ADMIN_KEY=${HOMELAB_SERVICES_SERVICE_PASSWORD?Missing PASSWORD}
DATABASE_URI=postgresql://aiometadata_app:${HOMELAB_SERVICES_DB_AIOMETADATA_PASSWORD_URIENCODED?Missing database password}@${HOMELAB_SERVICES_DB_HOST?Select environment}:${HOMELAB_SERVICES_DB_PORT?Select environment}/aiometadata?${HOMELAB_SERVICES_DB_TLS_QUERY?Select environment}
GEMINI_API_KEY=${HOMELAB_SERVICES_GEMINI_API_KEY?Missing GEMINI_API_KEY}
HOST_NAME=${HOMELAB_SERVICES_AIOMETADATA_BASE_URL?Select environment}
HTTP_PROXY=http://${GOST_LOCAL_HOSTNAME?Missing GOST_LOCAL_HOSTNAME}
MDBLIST_API_KEY=${HOMELAB_SERVICES_MDBLIST_API_KEY?Missing MDBLIST_API_KEY}
REDIS_URL=redis://:${HOMELAB_SERVICES_VALKEY_CACHE_PASSWORD_URIENCODED?Missing Redis password}@valkey-cache:6379/0
RPDB_API_KEY=${HOMELAB_SERVICES_RPDB_API_KEY?Missing RPDB_API_KEY}
SIMKL_CLIENT_ID=${HOMELAB_SERVICES_SIMKL_CLIENT_ID?Missing SIMKL_CLIENT_ID}
SIMKL_CLIENT_SECRET=${HOMELAB_SERVICES_SIMKL_CLIENT_SECRET?Missing SIMKL_CLIENT_SECRET}
SIMKL_REDIRECT_URI=${HOMELAB_SERVICES_AIOMETADATA_BASE_URL?Select environment}/api/auth/simkl/callback
TMDB_API_KEY=${HOMELAB_SERVICES_TMDB_API_KEY?Missing TMDB_API_KEY}
TVDB_API_KEY=${HOMELAB_SERVICES_TVDB_API_KEY?Missing TVDB_API_KEY}
TZ=${TZ?Missing TZ}

# Native OIDC via Authelia; configuration UUIDs and crypto keys stay unchanged.
OIDC_ENABLED=${HOMELAB_SERVICES_OIDC_ENABLED?Select environment}
OIDC_ISSUER=${HOMELAB_SERVICES_OIDC_ISSUER?Select environment}
OIDC_CLIENT_ID=${HOMELAB_SERVICES_OIDC_AIOMETADATA_CLIENT_ID?Select environment}
OIDC_CLIENT_SECRET=${HOMELAB_SERVICES_OIDC_AIOMETADATA_CLIENT_SECRET?Missing HOMELAB_SERVICES_OIDC_AIOMETADATA_CLIENT_SECRET}
OIDC_SCOPES='openid profile email groups'
OIDC_USERNAME_CLAIM='preferred_username'
OIDC_GROUPS_CLAIM='groups'
OIDC_GROUP_PERMISSIONS='admins=admin'
OIDC_DEFAULT_PERMISSIONS=''
OIDC_ALLOW_INSECURE_ISSUER='false'
OIDC_ALLOWED_EMAIL_DOMAINS='rajohan.no'

# Disable unused anime ingestion with native upstream settings.
MAL_WARMUP_ENABLED="false"
MAL_WARMUP_PRIORITY="false"
MAL_WARMUP_SCHEDULE="false"
MAL_WARMUP_DECADES="false"
MAL_WARMUP_METADATA="false"
ANIME_API_OVERLAY_ENABLED="false"
