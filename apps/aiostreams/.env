# Nonsecret settings and references; Doppler is loaded fresh by bin/compose.
AIOSTREAMS_AUTH=nzbproxy:${HOMELAB_SERVICES_AIOSTREAMS_PROXY_PASSWORD?Missing NZB proxy password}
AIOSTREAMS_AUTH_PERMISSIONS=nzbproxy=proxy
ADDON_PROXY=http://${GOST_LOCAL_HOSTNAME?Missing GOST_LOCAL_HOSTNAME}
BASE_URL=${HOMELAB_SERVICES_AIOSTREAMS_BASE_URL?Select environment}
CONFIG_ACCESS_KEY=${HOMELAB_SERVICES_SERVICE_PASSWORD?Missing PASSWORD}
DATABASE_URI=postgresql://aiostreams_app:${HOMELAB_SERVICES_DB_AIOSTREAMS_PASSWORD_URIENCODED?Missing database password}@${HOMELAB_SERVICES_DB_HOST?Select environment}:${HOMELAB_SERVICES_DB_PORT?Select environment}/aiostreams?${HOMELAB_SERVICES_DB_TLS_QUERY?Select environment}
DEFAULT_PROXY_CREDENTIALS=${HOMELAB_WEB_USERNAME?Missing USERNAME}:${HOMELAB_SERVICES_SERVICE_PASSWORD?Missing PASSWORD}
DEFAULT_PROXY_ENABLED='true'
DEFAULT_PROXY_ID='mediaflow'
DEFAULT_PROXY_PUBLIC_URL=${HOMELAB_SERVICES_MEDIAFLOW_BASE_URL?Select environment}
DEFAULT_PROXY_URL=http://${MEDIAFLOW_LOCAL_HOSTNAME?Missing MEDIAFLOW_LOCAL_HOSTNAME}
DEFAULT_SERVICE_CREDENTIALS=torbox.apiKey=${HOMELAB_SERVICES_TORBOX_API_KEY?Missing TORBOX_API_KEY}
DEFAULT_TIMEOUT='30000'
LOG_FORMAT='json'
LOG_SENSITIVE_INFO='false'
LOG_TIMEZONE=${TZ?Missing TZ}
MAX_STREAM_EXPRESSION_FILTERS='50'
REGEX_FILTER_ACCESS='all'
SECRET_KEY=${HOMELAB_SERVICES_AIOSTREAMS_SECRET_KEY?Missing AIOSTREAMS_SECRET_KEY}
TMDB_ACCESS_TOKEN=${HOMELAB_SERVICES_TMDB_ACCESS_TOKEN?Missing TMDB_ACCESS_TOKEN}
TMDB_API_KEY=${HOMELAB_SERVICES_TMDB_API_KEY?Missing TMDB_API_KEY}

# Native OIDC via Authelia; configuration UUIDs and crypto keys stay unchanged.
AIOSTREAMS_OIDC_ENABLED=${HOMELAB_SERVICES_OIDC_ENABLED?Select environment}
AIOSTREAMS_OIDC_ISSUER=${HOMELAB_SERVICES_OIDC_ISSUER?Select environment}
AIOSTREAMS_OIDC_CLIENT_ID=${HOMELAB_SERVICES_OIDC_AIOSTREAMS_CLIENT_ID?Select environment}
AIOSTREAMS_OIDC_CLIENT_SECRET=${HOMELAB_SERVICES_OIDC_AIOSTREAMS_CLIENT_SECRET?Missing HOMELAB_SERVICES_OIDC_AIOSTREAMS_CLIENT_SECRET}
AIOSTREAMS_OIDC_SCOPES='openid profile email groups'
AIOSTREAMS_OIDC_USERNAME_CLAIM='preferred_username'
AIOSTREAMS_OIDC_GROUPS_CLAIM='groups'
AIOSTREAMS_OIDC_GROUP_PERMISSIONS='admins=admin'
AIOSTREAMS_OIDC_DEFAULT_PERMISSIONS=''
AIOSTREAMS_OIDC_LINK_BY_USERNAME='false'
AIOSTREAMS_OIDC_ALLOW_LOCAL_LOGIN=${HOMELAB_SERVICES_OIDC_ALLOW_LOCAL_LOGIN?Select environment}
AIOSTREAMS_OIDC_AUTO_REDIRECT=${HOMELAB_SERVICES_OIDC_AUTO_REDIRECT?Select environment}
AIOSTREAMS_OIDC_ALLOW_INSECURE_REQUESTS='false'
AIOSTREAMS_OIDC_BUTTON_LABEL='Sign in with Homelab'
LINKED_ACCOUNTS_ALLOW_PRIVATE_URLS='true'

# Shared Valkey cache; explicit application SQL/memory caches remain unchanged.
REDIS_URI=redis://:${HOMELAB_SERVICES_VALKEY_CACHE_PASSWORD_URIENCODED?Missing cache password}@valkey-cache:6379/3

# Disable unused anime ingestion with native upstream settings.
ANIME_DB_LEVEL_OF_DETAIL="none"
# Sonarr rejects the generic AIOStreams user agent for this endpoint.
REQUEST_HEADER_OVERRIDES="services.sonarr.tv:{sonarr}"

# Show every configured catalog in the media apps; 0 disables the library cap.
JELLYFIN_MAX_LIBRARIES=0
TEMPLATE_URLS=["https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/Tamtaro-All-Templates-for-AIOStreams.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/refs/heads/main/all-templates.json"]
TEMPLATE_REFRESH_INTERVAL=3600
WHITELISTED_SYNC_REFRESH_INTERVAL=3600
CATALOG_CACHE_TTL=aiometadata.rajohan.no:-1,*:300
META_CACHE_TTL=aiometadata.rajohan.no:-1,*:300
MANIFEST_CACHE_TTL=aiometadata.rajohan.no:60,*:21600
REQUEST_URL_MAPPINGS={"https://aiometadata.rajohan.no":"http://aiometadata:3232"}
